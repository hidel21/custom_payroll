<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_sync_payroll_state" model="ir.cron">
        <field name="name">Comisiones: poner al día estados de liquidación</field>
        <field name="model_id" ref="model_invoice_commission_line" />
        <field name="state">code</field>
        <field name="code">model._cron_sync_payroll_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Desactivada: es una operación de mantenimiento, no una tarea
             periódica. Se lanza a mano cuando algo quedó descuadrado, por
             ejemplo comisiones dentro de un lote ya pagado que se quedaron en
             Por Liquidar porque nadie pulsó el botón de comprobantes. -->
        <field name="active" eval="False" />
    </record>

</odoo>