<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_commission_settlement_wizard_form" model="ir.ui.view">
        <field name="name">commission.settlement.wizard.form</field>
        <field name="model">commission.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar de estado">
                <field name="line_ids" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="authorized_count" invisible="1"/>
                <field name="authorizable_count" invisible="1"/>

                <!-- Lo que se va a marcar -->
                <div class="alert alert-info" role="status"
                     invisible="pending_count == 0">
                    Se marcarán como <b>liquidadas</b>
                    <b><field name="pending_count" class="oe_inline" readonly="1"/></b>
                    comisión(es), por un total de
                    <b><field name="total_amount" class="oe_inline" readonly="1"/></b>.
                </div>

                <!-- Lo que ya está liquidado -->
                <div class="alert alert-secondary" role="status"
                     invisible="already_count == 0">
                    <field name="already_count" class="oe_inline" readonly="1"/>
                    de las seleccionadas ya están liquidadas, por
                    <field name="revert_amount" class="oe_inline" readonly="1"/>.
                    <span groups="!custom_payroll.group_commission_state_manager">
                        No se tocan.
                    </span>
                    <span groups="custom_payroll.group_commission_state_manager">
                        Con <b>Devolver al estado anterior</b> vuelven a
                        <b>Por Liquidar</b> o <b>Por Cobrar</b>, según haya pagado
                        ya el cliente, y entran otra vez en el siguiente cálculo
                        de nómina.
                    </span>
                </div>

                <!-- Pago antes del cobro: no es lo normal, así que se
                     explica en lugar de dar solo un botón. -->
                <div class="alert alert-info" role="status"
                     invisible="authorizable_count == 0">
                    <field name="authorizable_count" class="oe_inline" readonly="1"/>
                    de las seleccionadas son de facturas que el cliente
                    <b>todavía no ha pagado</b>, por
                    <field name="authorizable_amount" class="oe_inline" readonly="1"/>.
                    Con <b>Autorizar pago sin cobro</b> entran igualmente en la
                    nómina del comercial. Hace falta escribir el motivo.
                </div>

                <group>
                    <field name="settlement_date"
                           invisible="pending_count == 0"/>
                    <!-- Sin restringir por grupo: el motivo lo necesitan las
                         dos correcciones, y autorizar un pago antes del cobro
                         no es trabajo exclusivo de quien corrige estados. -->
                    <field name="reason"
                           placeholder="Ej.: pago autorizado por Gerardo antes del recaudo"/>
                </group>

                <!-- El caso delicado: ese dinero ya salió hacia el comercial -->
                <div class="alert alert-warning" role="alert"
                     groups="custom_payroll.group_commission_state_manager"
                     invisible="closed_count == 0">
                    <b>Ojo:</b>
                    <field name="closed_count" class="oe_inline" readonly="1"/>
                    de estas comisiones están en un lote de nómina ya cerrado, o
                    sea que ya se le pagaron al comercial. Devolverlas hará que
                    se vuelvan a incluir en el próximo recibo. Hágalo solo si el
                    pago no llegó a salir.
                </div>

                <div class="alert alert-secondary" role="status"
                     groups="custom_payroll.group_commission_state_manager"
                     invisible="authorized_count == 0">
                    <field name="authorized_count" class="oe_inline" readonly="1"/>
                    de las seleccionadas están <b>autorizadas a pagarse sin que el
                    cliente haya pagado</b>. Entran en la nómina igual. Con
                    <b>Devolver al estado anterior</b> se revoca esa autorización.
                </div>

                <p class="text-muted">
                    Aquí no se escribe el estado a mano: se escriben las fechas y
                    el estado las sigue. La excepción es marcar una comisión como
                    Liquidada desde la propia lista, que autoriza su pago aunque
                    el cliente todavía no haya pagado la factura.
                </p>

                <footer>
                    <button name="action_settle" type="object"
                            string="Marcar como liquidada"
                            class="btn-primary" data-hotkey="q"
                            invisible="pending_count == 0"/>
                    <button name="action_authorize" type="object"
                            string="Autorizar pago sin cobro"
                            class="btn-secondary" data-hotkey="a"
                            invisible="authorizable_count == 0"
                            confirm="Estas comisiones se pagarán al comercial aunque el cliente no haya pagado la factura. Quedará registrado su nombre y el motivo. ¿Continuar?"/>
                    <button name="action_revert" type="object"
                            string="Devolver al estado anterior"
                            class="btn-warning" data-hotkey="w"
                            groups="custom_payroll.group_commission_state_manager"
                            invisible="already_count == 0 and authorized_count == 0"
                            confirm="Se quitará la fecha de liquidación y las comisiones volverán a entrar en el próximo cálculo de nómina. Quedará registrado su nombre y el motivo. ¿Continuar?"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- La acción sale en el menú Acciones del Reporte de Comisiones, que es
         donde se revisa lo que ya se pagó. Se añade el grupo de corrección para
         que la vea también quien tenga ese permiso sin ser de nómina. -->
    <record id="action_commission_settlement_wizard" model="ir.actions.act_window">
        <field name="name">⇄ Cambiar de estado</field>
        <field name="res_model">commission.settlement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_commission_settlement_wizard_form"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user')),
                                       (4, ref('custom_payroll.group_commission_state_manager'))]"/>
        <field name="binding_model_id" ref="intelli_commision.model_invoice_commission_line"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
